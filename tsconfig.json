{
  "compilerOptions": {
    /* --- 基本設定 --- */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* --- 厳格な型チェック --- */
    "strict": true,

    /* --- プロジェクト構造に関する設定 --- */
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./src",

    /* --- DIライブラリ(tsyringe)で必要な設定 --- */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* --- その他 --- */
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}

